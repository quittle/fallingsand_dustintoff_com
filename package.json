{
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "dev:rust": "vite --config vite.config.rust.js",
        "build:rust": "npm run wasm-pack && vite build --config vite.config.rust.js",
        "wasm-pack": "wasm-pack build rust --target bundler",
        "prettier-check": "prettier . --check",
        "prettier": "prettier . --write",
        "cargo-fmt-check": "cd rust && cargo fmt --all --check",
        "cargo-fmt": "cd rust && cargo fmt --all",
        "clippy-check": "cd rust && cargo clippy --all-targets --all-features -- -D warnings",
        "clippy": "cd rust && cargo clippy --fix --allow-dirty --allow-staged",
        "format-check": "npm run prettier-check && npm run cargo-fmt-check",
        "format": "npm run prettier && npm run clippy && npm run cargo-fmt",
        "type-check": "tsc --noEmit",
        "test": "npm run build:rust && NODE_OPTIONS='--experimental-vm-modules' jest --detectOpenHandles",
        "release": "npm run format-check && npm run clippy-check && npm run wasm-pack && npm run type-check && npm run build:rust && npm run test",
        "deploy": "./scripts/deploy"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "electron": "^45.4.1",
        "gl-matrix": "^3.4.3",
        "hello-wasm": "file:rust/pkg",
        "jest": "^30.5.2",
        "prettier": "^3.0.0",
        "puppeteer": "^25.19.0",
        "s3-upload-custom-resource-lambda-layer": "^1.4.0",
        "ts-jest": "^29.4.15",
        "typescript": "^5.1.6",
        "vite": "^8.4.0",
        "vite-plugin-wasm": "^3.6.0",
        "vite-plugin-watch": "^0.2.0",
        "wasm-pack": "^0.15.1",
        "webgl-lint": "^1.11.2"
    }
}
