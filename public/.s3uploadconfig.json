{
    "version": 1,
    "files": {
        "**/*.html": {
            "cacheControl": "public, max-age=900",
            "contentType": "text/html"
        },
        "**/*.js": {
            "cacheControl": "public, max-age=900",
            "contentType": "text/javascript"
        },
        "**/*.png": {
            "cacheControl": "public, max-age=900",
            "contentType": "image/png"
        },
        "**/*.grw": {
            "cacheControl": "public, max-age=900",
            "contentType": "text/xml"
        },
        "**/*": {
            "cacheControl": "public, max-age=900"
        }
    }
}
